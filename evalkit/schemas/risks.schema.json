{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Risk register",
  "type": "object",
  "required": ["risks"],
  "additionalProperties": false,
  "properties": {
    "system": { "type": "string", "description": "What is under test, in one line." },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rank", "title", "layer"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]+$" },
          "rank": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "example": { "type": "string" },
          "why": { "type": "string" },
          "layer": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["pipeline", "evaluation", "oversight", "monitoring"] }
          },
          "manual": {
            "type": "string",
            "description": "Set when the risk is covered outside automated tests; say how. Coverage then accepts it without tests."
          }
        }
      }
    }
  }
}
